{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/queues/job_envelope.schema.json",
  "title": "JobEnvelope",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "job_id", "tenant_id", "job_type", "priority", "attempt", "max_attempts", "created_at", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": ["string", "null"]},
    "environment_id": {"type": ["string", "null"]},
    "job_type": {"type": "string", "minLength": 1},
    "priority": {"enum": ["P1", "P2", "P3", "P4", "P5"]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 100},
    "not_before": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": ["string", "null"]},
    "payload": {"type": "object", "maxProperties": 100}
  },
  "additionalProperties": false
}
