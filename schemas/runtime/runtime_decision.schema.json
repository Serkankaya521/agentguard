{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/runtime/runtime_decision.schema.json",
  "title": "RuntimeDecision",
  "description": "Final runtime decision with mandatory correlation and performance metadata. Carries no PII or secrets.",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "decision_id", "tenant_id", "event_id", "trace_id", "policy_version", "policy_hash", "runtime_version", "risk_score", "reason_codes", "cache_source", "latency_us", "trajectory_version", "decision", "fail_mode", "action_state"],
  "properties": {
    "schema_version": {"type": "string"},
    "decision_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string"},
    "policy_hash": {"type": "string"},
    "runtime_version": {"type": "string"},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "cache_source": {"enum": ["l1", "l2", "l3", "computed", "none"]},
    "latency_us": {"type": "integer", "minimum": 0},
    "trajectory_version": {"type": "integer", "minimum": 0},
    "capability_id": {"type": ["string", "null"]},
    "decision": {"enum": ["ALLOW", "BLOCK", "REQUIRE_APPROVAL", "SANDBOX", "REDACT", "STEP_UP_AUTH", "ASYNC_DEEP_ANALYSIS"]},
    "fail_mode": {"enum": ["fail_open", "fail_closed"]},
    "action_state": {"enum": ["proposed", "blocked", "approved", "executed"]}
  },
  "additionalProperties": true
}
