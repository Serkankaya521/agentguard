{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/evidence/evidence.schema.json",
  "title": "Evidence",
  "description": "Tenant-scoped, integrity-protected evidence record. Prefers references/hashes over raw payloads; keeps blocked/proposed/approved/executed distinct.",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "evidence_id", "tenant_id", "event_id", "action_state", "sources", "integrity_hash", "created_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "evidence_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": ["string", "null"]},
    "action_state": {"enum": ["proposed", "blocked", "approved", "executed"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["deterministic_state", "tool_output", "policy_trace",
                            "resource_mutation", "hash", "network_event", "telemetry",
                            "approval_record", "sandbox_observation", "model_claim"]},
          "ref": {"type": "string"},
          "summary": {"type": "object"}
        }
      }
    },
    "prev_hash": {"type": ["string", "null"]},
    "integrity_hash": {"type": "string", "minLength": 1},
    "signature": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
