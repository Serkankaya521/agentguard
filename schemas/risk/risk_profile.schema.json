{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/risk/risk_profile.schema.json",
  "title": "RiskProfile",
  "description": "Precomputed risk profile published asynchronously by AEGIS and read from cache on the hot path. Runtime never treats it as verified fact; stale/invalid -> policy-defined fallback.",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "subject_type", "subject_id", "tenant_id", "environment", "risk_score", "confidence", "source", "version", "generated_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "subject_type": {"enum": ["agent", "tool", "mcp", "behavioral", "architecture"]},
    "subject_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "environment": {"enum": ["production", "staging", "development", "test"]},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string"},
    "version": {"type": "string"},
    "generated_at": {"type": "string"},
    "expires_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
