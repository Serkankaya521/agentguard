{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/approvals/approval_request.schema.json",
  "title": "ApprovalRequest",
  "version": "1.0.0",
  "type": "object",
  "required": ["schema_version", "request_id", "tenant_id", "identity_id", "tool_id", "capability_id", "resource", "expires_at", "use_mode", "required_approvals", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": ["string", "null"]},
    "environment_id": {"type": ["string", "null"]},
    "identity_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": ["string", "null"]},
    "session_id": {"type": ["string", "null"]},
    "tool_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "resource": {"type": "string", "minLength": 1, "maxLength": 2048},
    "expires_at": {"type": "string", "format": "date-time"},
    "use_mode": {"enum": ["one_time", "reusable_scoped"]},
    "max_uses": {"type": "integer", "minimum": 1, "maximum": 1000},
    "required_approvals": {"type": "integer", "minimum": 1, "maximum": 10},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
