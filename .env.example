# Security worker Rules of Engagement (deny by default). Live red-team traffic only goes to
# origins listed for the campaign's tenant, and campaigns may only use the secret names listed
# there. Prefer REDTEAM_ROE_FILE (mounted config) in deployments.
# REDTEAM_ROE_JSON={"tenants":{"<tenant-uuid>":{"targets":["https://agent.example.com"],"secrets":["AG_REDTEAM_<NAME>_API_KEY"]}}}
REDTEAM_ROE_FILE=
REDTEAM_ROE_JSON=
