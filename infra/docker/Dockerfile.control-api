FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/apps/control-api/src:/app/packages/auth/src:/app/packages/observability/src:/app/packages/contracts/src:/app/packages/domain/src:/app/packages/policy/src:/app/packages/evidence/src:/app/apps/runtime-gateway/src
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system agentguard && useradd --system --gid agentguard --uid 10001 agentguard
WORKDIR /app
COPY apps/control-api/requirements.lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY apps/control-api apps/control-api
COPY apps/runtime-gateway/src/execution_gate.py apps/runtime-gateway/src/execution_gate.py
COPY packages packages
COPY schemas schemas
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn","main:app","--app-dir","apps/control-api/src","--host","0.0.0.0","--port","8080","--no-access-log","--limit-concurrency","64","--timeout-keep-alive","5"]
