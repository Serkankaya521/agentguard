FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/apps/runtime-gateway/src:/app/packages/policy/src:/app/packages/detectors/src:/app/packages/contracts/src:/app/packages/domain/src:/app/packages/evidence/src:/app/packages/observability/src
RUN groupadd --system agentguard && useradd --system --gid agentguard --uid 10001 agentguard
WORKDIR /app
COPY apps/control-api/requirements.lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY apps/runtime-gateway apps/runtime-gateway
COPY packages/policy packages/policy
COPY packages/detectors packages/detectors
COPY packages/contracts packages/contracts
COPY packages/domain packages/domain
COPY packages/evidence packages/evidence
COPY packages/observability packages/observability
COPY schemas schemas
USER 10001:10001
CMD ["uvicorn","main:app","--app-dir","apps/runtime-gateway/src","--host","0.0.0.0","--port","8081","--no-access-log","--limit-concurrency","256"]
